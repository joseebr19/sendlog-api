/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "placements-api",
	"main": "src/index.js",
	"compatibility_date": "2026-08-25",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"workers_dev": true,
	"vars": {
		"GOOGLE_CLIENT_ID": "506206154159-4910jhuollic3fg1gbggd4nbmkuc43g7.apps.googleusercontent.com"
	},
	"assets": {
		"directory": "./public/",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"routes": [
		{ "pattern": "app.luvbesly.com", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "placements",
			"database_id": "83bdd480-8257-405c-9284-a7902ec86aa2"
		}
	],
	"ratelimits": [
		{
			"name": "API_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 120, "period": 60 }
		}
	]
}